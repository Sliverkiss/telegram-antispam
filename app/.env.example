# Telegram bot token (required). Get it from @BotFather.
BOT_TOKEN=

# HTTP listen address (belmo health check hits :3000).
BOT_ADDR=:3000

# Enforcement action: "ban" (permanent) or "kick" (ban then unban).
BOT_ACTION=ban

# Skip group owners/admins to avoid self-hits.
BOT_IGNORE_ADMINS=true

# Delete the "X joined" system message on signature-hit disposal.
BOT_DELETE_JOIN_MSG=false

# Optional chat id for disposal notifications. Empty = disabled.
BOT_LOG_CHAT=

# Logging.
BOT_LOG_LEVEL=info        # debug|info|warn|error
BOT_LOG_FORMAT=text       # text|json

# Redis (optional). redis:// or rediss:// (TLS). Empty = in-memory.
BOT_REDIS_URL=
BOT_REDIS_INSECURE_TLS=false
BOT_SUSPECT_TTL=          # e.g. 24h; empty = never expire

# AI classifier (OpenAI-compatible).
BOT_AI_BASE_URL=https://mimo.xn--ug8h.eu.org/v1
BOT_AI_API_KEY=
BOT_AI_MODEL=mimo-v2.6-pro-ultraspeed-studio
BOT_AI_TIMEOUT=30s

# Admin API guard. Empty = /admin/* routes closed.
BOT_ADMIN_TOKEN=

# Per-chat+user tracked message cap for "delete all known messages".
BOT_MAX_TRACKED_MSGS=200