# ============================================================================
# adbot 环境变量样板（与 TASK_antispam_amend1.md §6 契约一致）
# 复制为 .env 使用；.env 已被 .gitignore 排除，绝不入库。
# 敏感值（BOT_TOKEN / BOT_AI_API_KEY / BOT_REDIS_URL 等）只写进 .env，
# 不要出现在本文件、README 或代码里。
# ============================================================================

# ── 核心 ────────────────────────────────────────────────────────────────────
# BotFather 发放的 token（必填）。
BOT_TOKEN=

# HTTP 监听地址（belmo 健康检查打 :3000）。
BOT_ADDR=:3000

# 授权群白名单（逗号分隔的 chat id，如 -1001234567890）。
# 只服务这些群；留空 = 不授权任何群，所有群都会被退出并打 WARN。
BOT_CHATS=

# 被拉进非白名单群时立即自动退出（my_chat_member 触发）。
BOT_LEAVE_OTHER_CHATS=true

# 退出非白名单群前先发一句简短中文说明。
BOT_LEAVE_NOTICE=true

# 管理员用户 id（逗号分隔）：其消息永不判定，并跳过入群验证清理。
BOT_ADMIN_USERS=

# 干跑模式：true 时只判定+打日志，绝不封禁/删除（启动与 /start 回复显著显示）。
BOT_DRY_RUN=false

# ── 行为 ────────────────────────────────────────────────────────────────────
# 处置动作：kick（封禁后立即解封=踢出，默认）/ ban（永久封禁）。
BOT_ACTION=kick

# 跳过群管理员/群主，避免误杀自己人。
BOT_IGNORE_ADMINS=true

# 是否删除广告号的入群系统消息（签名命中时）。
BOT_DELETE_JOIN_MSG=false

# 处置通知发到哪个 chat id（可选，0=关闭）。非遗发唯一入口：处置/
# 报错通知都走它（amend4）。启动时会 getChat + getChatMember(本账号) 自检
# 可达性与发帖权限，失败只 WARN 并在 /statusz 标 notify.target_ok=false，
# 不阻塞启动。
BOT_LOG_CHAT=0

# bot 在聊天里发出的所有消息（/start 命令回复、
# 退群提示、送客公告）延迟自动删除；0 = 永不删（amend8 统一了旧的
# BOT_CMD_AUTODELETE_SEC 与 BOT_ANNOUNCE_TTL）。通知频道（BOT_LOG_CHAT）
# 的推送不受影响——永久保留。内存模式下进程重启会丢失未到期的删除
# 任务：那几条消息不会被删（已知代价，不做兜底）。
BOT_MSG_TTL=60s

# ── 存储与保留 ──────────────────────────────────────────────────────────────
# 存储后端：memory（默认）| redis | file | auto。memory 重启后
# 观察名单/签名库/统计会丢失（封禁在 Telegram 服务端生效，不会因重启解除）。
BOT_STORE=memory

# Redis 连接串（redis:// 或 rediss://，启用 redis 后端时必填）。
BOT_REDIS_URL=

# 跳过 Redis 证书校验（仅开发环境）。
BOT_REDIS_INSECURE_TLS=false

# 文件后端数据库路径（reserved：file 后端明确不实现——内存模式是最终
# 选择，配置 file 会打 WARN 并回落内存，重启丢数据属预期行为）。
BOT_DB_PATH=data/adbot.db

# 文件后端写盘是否 fsync（默认 false）。
BOT_DB_FSYNC=false

# 全局记录保留时长（默认 72h；0 或负数 = 永不过期）。
BOT_RETENTION=72h

# 分类覆盖（不设则跟随 BOT_RETENTION）：观察名单 / 签名库。
BOT_RETENTION_SUSPECT=
BOT_RETENTION_SIGNATURE=

# 滑动过期：命中/刷新时续 ts（默认 true，热门签名不被反复清掉）。
BOT_RETENTION_SLIDING=true

# janitor 清扫间隔（默认 10m；启动时也先跑一次）。
BOT_SWEEP_INTERVAL=10m

# 容量护栏：超限按最旧淘汰并打 WARN。
BOT_MAX_SUSPECTS=50000
BOT_MAX_SIGNATURES=50000

# ── AI 判定 ──────────────────────────────────────────────────────────────────
# OpenAI 兼容网关（必填）。填你自己的端点，例如 https://your-gateway.example.com/v1
# 留空/占位符会让 AI 判定全部失败并走本地规则兜底（不会误封，但精度下降）。
BOT_AI_BASE_URL=https://api.your-gateway.invalid/v1

# 判定 API Key（缺失则跳过 AI 判定并 WARN，绝不误封）。
BOT_AI_API_KEY=

# 模型回退链（逗号分隔，默认三模型）。amend6 B.3：ultraspeed 当前挂死
# （120s 读超时），挪到链尾；线上无需改代码，设置本变量即可再调回。
BOT_AI_MODELS=mimo-v2.6-pro,mimo-v2.6-flash,mimo-v2.6-pro-ultraspeed-studio

# 兼容旧配置：单模型；与 BOT_AI_MODELS 同时存在时以 BOT_AI_MODELS 为准。
BOT_AI_MODEL=mimo-v2.6-pro-ultraspeed-studio

# 单次 AI 判定超时（amend6 B.1 放宽 60s→90s：异步化后长超时不再阻塞别人）。
BOT_AI_TIMEOUT=90s

# 单条判定的整条链总预算（amend6 B.2）：超出即放弃本次判定转重试队列，
# 防止一个挂死模型把判定槽占满 3×90s。
BOT_AI_JUDGE_TIMEOUT=150s

# 关闭模型思考（默认 none；网关校验过 reasoning_effort=none 与
# enable_thinking=false 双通道，绝不发送 max_tokens）。
BOT_AI_REASONING_EFFORT=none

# 提示词文件覆盖（默认内嵌 judge_v2；指向磁盘文件可在不发版的情况下调优）。
BOT_AI_PROMPT_FILE=

# 失败重试（固定间隔、不退避、不熔断、不静默丢弃）。
BOT_AI_RETRY_INTERVAL=10s
BOT_AI_RETRY_MAX_ATTEMPTS=5
BOT_AI_RETRY_QUEUE=500

# 置信度不足（< 阈值）时并发复核：≥ BOT_AI_VERIFY_MAJORITY 票判广告才处置。
# 单路复核有自己的超时（BOT_AI_VERIFY_TIMEOUT，默认 45s），失败/超时的路
# 弃权（不算"不是广告"票）。
BOT_AI_MIN_CONFIDENCE=0.85
# 处置门限（amend13「85分以上才踢出去」）：AI 判广告但最终分 < 85 时放过
# （不踢不删，留痕计数）。复核投出 ad 时最终分 = 判广告复核路的平均置信度。
# 两个阈值的关系：BOT_AI_MIN_CONFIDENCE 管「何时触发复核」，本变量管「多高
# 的分才处置」。0 = 关闭门限（旧行为：判广告即踢）；负数/超 100 回落 85。
BOT_AI_MIN_PUNISH_SCORE=85
BOT_AI_VERIFY_VOTES=3
BOT_AI_VERIFY_MODELS=mimo-v2.6-flash
BOT_AI_VERIFY_MAJORITY=2
BOT_AI_VERIFY_TIMEOUT=45s

# 备用 provider（可选）。
BOT_AI_FALLBACK_BASE_URL=
BOT_AI_FALLBACK_API_KEY=
BOT_AI_FALLBACK_MODELS=

# 相似度匹配（SimHash 海明距离）。
BOT_SIMHASH_DISTANCE=3

# 本地规则兜底（仅在 AI 连续不可达时生效）。
BOT_LOCAL_RULES_ENABLED=true
BOT_LOCAL_RULE_THRESHOLD=3

# 追加本地高危词表（逗号分隔，附加到内置词表后）。
BOT_LOCAL_KEYWORDS=

# ── 运行时 / 日志 / 管理 ─────────────────────────────────────────────────────
# 长轮询超时（秒）与并发 worker 数。
BOT_POLL_TIMEOUT=30
BOT_WORKERS=4

# ── 判定异步池（amend6 A）───────────────────────────────────────────────────
# 逃生开关：false 时退回判定在 update handler 内同步执行（线上出问题一行回滚）。
BOT_JUDGE_ASYNC=true

# 有界提交队列容量；满了不丢弃——转交重试队列并打 WARN。
BOT_JUDGE_QUEUE=500

# 判定并发数（不同用户的判定并发执行；同一 uid 严格按提交顺序串行）。
BOT_AI_CONCURRENCY=8

# 优雅关闭排空预算（judge_pool_stopped 日志的等待上限）。
BOT_JUDGE_DRAIN=10s

# 库层 update 分发 worker 数（1..128）。go-telegram/bot 默认 1 个——一条慢
# 判定曾把整个 bot 卡住 66 秒，必须放大。
BOT_UPDATE_WORKERS=16

# 日志级别与格式。
BOT_LOG_LEVEL=info
BOT_LOG_FORMAT=text

# 管理 API 守卫：非空才开放 /admin/*（签名库增删查），校验 Authorization: Bearer。
BOT_ADMIN_TOKEN=

# 版本号（默认 dev，由构建注入）。
BOT_VERSION=dev
# ── 通知推送（amend4）────────────────────────────────────────────────────────
# 处置通知（⏱️/💬/👤/✅ 四行模板）。关掉后处置不产生任何推送。
BOT_NOTIFY_ON_PUNISH=true

# 报错通知（📵 Telegram 写失败 / ⚠️ AI 连续失败 / 🧊 池级错误 /
# 🗑️ 队列溢出 / 📦 容量淘汰 / 启动自检失败）。关掉后报错只进本地日志。
BOT_NOTIFY_ON_ERROR=true

# 报错推送级别：error（只推 ERROR）| warn（连 WARN 一起推）。
BOT_NOTIFY_LEVEL=error

# 令牌桶限流：每分钟最多推送条数。超限入队等待（不丢弃）。
BOT_NOTIFY_RATE=20

# 异步有界队列容量；溢出丢弃并累计，每窗口汇报一次抑制条数。
BOT_NOTIFY_QUEUE=200

# 同类错误去重窗口（事件类型+chat/uid+错误码做指纹；窗口内只推首条，
# 窗口末补一条汇总）。队列溢出的抑制汇报也按这个窗口周期。
BOT_NOTIFY_DEDUPE_WINDOW=5m

# 单条通知文本上限（Telegram 硬限制 4096 之外的自收紧上限）。
BOT_NOTIFY_MAX_LEN=1024

# 证据摘要（💬 行）长度上限。注意：四行模板的 💬 行按模板固定截 80
# 字符；这个值约束其他场景附带的原文摘要。
BOT_NOTIFY_TEXT_LEN=120

# 处置通知是否附带广告原文（💬 行）。false 时整行省略（隐私优先）。
BOT_NOTIFY_INCLUDE_TEXT=true

# 优雅关闭时的排空预算：worker 最多再花这么久把队列里剩下的发完。
BOT_NOTIFY_DRAIN=5s

# ── 管理员缓存（amend4 §4.5）────────────────────────────────────────────────
# getChatMember 结果的 TTL 缓存：避免每条群消息打一次 Telegram API。
# 只缓存确定结果（API 报错绝不写缓存，防止网络抖动冻结错误身份）。
BOT_ADMIN_CACHE_TTL=5m

# 缓存容量上限；超限按最旧淘汰。
BOT_ADMIN_CACHE_MAX=5000

# ── 送客公告（amend7）──────────────────────────────────────────────────────
# 处置成功后在群内发一条 AI 生成的可爱短公告（踢出/ban 都算）。公告的
# AI 生成+发送走独立 goroutine，绝不阻塞处置链；AI 失败/超时/输出不合规
# 走本地模板池兜底；同一处置（chat+uid+messageID）只发一条；干跑不发。
BOT_ANNOUNCE_KICK=true

# 公告生成独立短超时（默认 8s，clamp 1s~20s；不重试，失败即模板兜底）。
# 公告发送后的延迟删除统一走 BOT_MSG_TTL（amend8；BOT_ANNOUNCE_TTL 已移除）。
BOT_ANNOUNCE_TIMEOUT=8s

# ── 裸号必杀（amend9）────────────────────────────────────────────────────────
# 入群「裸号」判据：Premium 会员 + 英文名 + 无简介 + 无头像，四条件 AND
# 全中即直接处置（source=join_rule，不经 AI）。is_premium 在入群时无条件补
# 一次 getChatMember 再核（update 字段是否填充未经验证，两者取 OR）。
# false = 完全跳过该判据。
BOT_JOIN_NAKED_PREMIUM=true

# ── 入群验证（amend10/11）───────────────────────────────────────────────────
# 300 秒贴纸门。amend11 顺序（铁律）：观察名单 → 签名库 → 裸号必杀 →
# AI 简介判定 → 入群验证 →（无简介）等发言。欢迎消息与登记挂在简介判定的
# 【最终非广告结论】出口上（首判/重试轮/本地规则兜底走同一出口，幂等只发
# 一次）：结论是广告 → 直接处置（绝不欢迎）；结论非广告 → 才欢迎+起 300s；
# 判定失败/超时 → 走现有重试队列，重试期间不欢迎不登记，等结论落地再定。
# 无简介 → 无可判 → 入群即欢迎。登记前先 getChatMember 体检：人已不在
# （left/kicked）→ 不欢迎不登记（reason=gone）；已被本方处置 → 跳过。
# 只认 message.sticker（纯 emoji 文本/文字/图片一律不算）。验证未通过期间
# 该用户的消息绝不送 AI；到期处置前再 getChatMember 二次确认：人不在 →
# 只清理绝不处置；被限制不能发言 → 只清理不处置（WARN）；正常在群 →
# 走标准处置链（默认真封禁 ban + 通知频道证据串 + 群内 AI 公告）；查询
# 失败重试 2 次后仍处置（fail-open）。被任何人/别的 bot 踢（chat_member
# left/kicked/restricted）→ 清 pending+删欢迎+零处置。pending 只存内存：
# 重启丢待验证名单，残留欢迎消息不做补偿（见 README 已知限制）。
BOT_JOIN_VERIFY=true

# 验证时限（默认 300s，clamp 1s~24h）。
BOT_JOIN_VERIFY_TIMEOUT=300s

# 超时扫描间隔（独立单 ticker，随进程关闭；默认 5s，clamp 100ms~1m）。
# 绝不为每个入群者起一个 time.AfterFunc goroutine。
BOT_JOIN_VERIFY_SCAN=5s

# 超时处置动作：ban（默认，真封禁）/ kick（封后即解=踢出可再加）。
BOT_JOIN_VERIFY_ACTION=ban

# 欢迎消息固定文案（%s = @用户名，无用户名时用名字）。该消息不走
# BOT_MSG_TTL 的 60 秒全局自删——验证结束（通过/超时/退群）即删。
BOT_JOIN_VERIFY_MSG=👋 欢迎 %s！请在 300 秒内发一个贴纸，证明你不是机器人，否则会被移出本群～

# 待验证名单容量上限（默认 5000）；超限拒绝新登记并打 WARN，该用户走原流程。
BOT_JOIN_VERIFY_MAX_PENDING=5000

# ── 频道帖子评论审简介（amend12）─────────────────────────────────────────────
# 群（有关联频道）里的消息如果是在频道帖子下面回复的（reply 的目标消息
# is_automatic_forward=true，即关联频道帖子的自动转发），检查评论者的简介：
# 简介带链接或 @ → 进 AI 审核流程（审的是简介本身，mode=bio 复用入群提示词
# 通道）；审出广告 → 走标准处置链（b.punish：踢/封 + 通知频道推送 + 群内
# AI 公告 + 写 bio 签名库）。判非广告 → 零处置、不消费观察名额（简介是
# 独立屏，同入群简介语义）。简介为空/无链接无 @ / 非评论消息 → 完全走
# 原流程（行为零变化）。管理员/白名单外豁免沿用现有 gate。
BOT_COMMENT_BIO_SCREEN=true

# 防刷窗口（默认 30m，clamp 0=窗口不自动过期 或 ≤24h）：审核未过（判广告）
# 的简介进防刷缓存；窗口内再遇到【重复】（normalized sha1 精确匹配）的
# 直接踢、零 AI 调用。这不是限流——只为跳过已判死的简介，绝不为此牺牲
# 正确性。窗口过期后重新送审。
BOT_COMMENT_BIO_FLASH_TTL=30m

# 防刷缓存容量上限（默认 5000）；超限按最旧淘汰。只存内存：重启丢失
# （与入群验证 pending 同语义，丢的只是防刷加速，重新送审即可）。
BOT_COMMENT_BIO_FLASH_MAX=5000

# ── 简介 @ 解析（bio-resolve 轮）─────────────────────────────────────────────
# 简介里带 @ 的，送 AI 审核前先把 @ 对应的 t.me 目标的简介（用户 bio 或
# 频道 description）抓下来，以【相关简介】块附在送审文本里一起判定——
# "更稳一点"（需求方原话）。@ 解析失败按原简介判定（不当判定失败、不重
# 试）；签名库/防刷/通知证据仍用原始简介（别人频道的简介变了不会污染我
# 们自己的签名库）。@ 是否触发送审的门限不变（本轮只改判据）。
BOT_BIO_RESOLVE=true

# 每条简介最多解析几个 @（默认 3）；超出的跳过并打 WARN（防链接农场
# 简介无限发散查询）。clamp ≥1。
BOT_BIO_RESOLVE_MAX=3

# 整组 @ 查询的总时限（默认 10s；0 = 不设独立上限，单次 getChat 仍受调用
# 方 ctx 约束）。
BOT_BIO_RESOLVE_TIMEOUT=10s
